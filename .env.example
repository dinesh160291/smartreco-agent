# SmartReco environment — copy to .env and fill in. Never commit .env.
# All variables documented in docs/implementation/stack-decisions.md.

# --- AI Provider Gateway (OpenAI-compatible; provider is deployment configuration) ---
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini
AI_GATEWAY_EMBED_MODEL=openai/text-embedding-3-small

# Embedding backend: "gateway" | "local" — set from the gateway probe result
# (scripts/probe_gateway.py). "local" uses Chroma's built-in embedding function.
EMBEDDINGS_BACKEND=local

# --- Data layer ---
DATABASE_URL=sqlite:///./data/smartreco.db
CHROMA_PATH=./data/chroma

# --- Web app ---
SECRET_KEY=change-me

# --- Digest delivery (Telegram primary; Email optional) ---
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
